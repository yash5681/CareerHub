# ============================================================
# CAREERHUB ENVIRONMENT CONFIGURATION
# ============================================================

# Security
SECRET_KEY=careerhub-super-secret-production-grade-key-change-in-prod-xyz123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DB_NAME=careerhub_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Razorpay Payment Gateway (Test Mode)
# Replace with your Razorpay Test Key and Secret from dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_CareerHubDemoKey
RAZORPAY_KEY_SECRET=CareerHubDemoSecretKeyXYZ123
RAZORPAY_CURRENCY=INR

# Email Settings (Console backend used when SMTP disabled)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CareerHub Support <noreply@careerhub.in>

# Localization
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata
